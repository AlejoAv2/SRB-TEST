  <!-- Sección Pie de página-->
  <footer id="piePagina">
    <article class="container">
      <div class="row g-4 justify-content-between align-items-stretch footer-main wrapper-footer-skew">
        <div class="col-sm-12 col-md-6 col-lg-5 d-flex">
          <div class="footer-skew-col w-100">
            <div class="footer-vertical-block">
              <p class="p-pp mb-0">
                {{{footer.infoHtml}}}
              </p>
            </div>
          </div>
        </div>
        <div class="col-sm-12 col-md-6 col-lg-3 d-flex">
          <div class="footer-skew-col footer-skew-col-mid w-100">
            <div class="footer-vertical-block">
              <p class="p-pp mb-0">
                {{{footer.aliadosHtml}}}
              </p>
            </div>
          </div>
        </div>
        <div class="col-sm-12 col-lg-4 d-flex justify-content-center justify-content-lg-end align-items-center gap-3">
          <div class="footer-badge">
            <img src="{{footer.logoMercantil}}" alt="" loading="lazy" decoding="async">
          </div>
          <div class="footer-badge footer-badge-wide">
            <img src="{{footer.logoCamara}}" alt="" loading="lazy" decoding="async">
          </div>
        </div>
      </div>

      <div class="footer-bottom d-flex justify-content-center pt-4 mt-4">
        <img src="{{footer.logoPie}}" alt="" style="height: 48px;" loading="lazy" decoding="async">
      </div>
    </article>
  </footer>

