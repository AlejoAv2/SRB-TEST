  <!-- Sección Quiénes somos con Mosaico Visual de Centros de Monitoreo -->
  <section id="quienesSomos" class="section-quienes">
    <article class="container">
      <div class="quienes-card mx-auto reveal-up">
        <div class="row align-items-center g-4 g-lg-5">
          <div class="col-lg-7">
            <div class="heading-wrap text-center text-lg-start mb-4">
              <h2 class="colorAzul titulo section-heading section-heading-left d-inline-block mb-0">{{quienesSomos.titulo}}</h2>
            </div>
            <p class="colorNegro parrafo text-lg-start mb-0">{{quienesSomos.descripcion}}</p>
          </div>
          <div class="col-lg-5">
            <div class="quienes-visual-stack">
              <div class="quienes-photo-primary">
                <img src="{{quienesSomos.fotoPrincipal}}" alt="" loading="lazy" decoding="async">
              </div>
              <div class="quienes-photo-secondary" data-parallax-speed="-0.08">
                <img src="{{quienesSomos.fotoSecundaria}}" alt="" loading="lazy" decoding="async">
              </div>
              <div class="quienes-iso-floating" aria-hidden="true">
                <img src="{{site.isotipoClaro}}" alt="" loading="lazy" decoding="async">
              </div>
            </div>
          </div>
        </div>
      </div>
    </article>
  </section>
